# 示例配置：不会被自动加载，须通过进程环境变量设置；凭据只放服务端受保护配置，不要提交。
# DATABASE_URL、SHOW_REFERENCE_DIAGNOSIS 尚未接入实现。
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
SHOW_REFERENCE_DIAGNOSIS=false

# simulator：本地确定性模拟；nexent：调用真实 Nexent 北向接口（须先完成 docs/nexent-integration.md 的部署与核验）
NEXENT_MODE=simulator
# 北向服务地址（Docker 部署默认端口 5013，不含 /nb/v1 路径）
NEXENT_BASE_URL=
NEXENT_API_KEY=
NEXENT_PATIENT_AGENT=
NEXENT_FEEDBACK_AGENT=
NEXENT_CONNECT_TIMEOUT_S=5
NEXENT_FIRST_EVENT_TIMEOUT_S=20
# 时间配置必须为有限正数；首事件截止含响应头/注释等待，之后仍有读取空闲超时。
# 总预算含停止请求，内部预留至多0.25秒且不超过总预算25%；不是整个前端交互的耗时承诺。
NEXENT_TOTAL_TIMEOUT_S=55
TURN_TTL_S=120

# 可信 MCP 服务（python -m app.mcp_server）：必须设置至少16位的共享令牌，Nexent 注册时以 Bearer 头携带
MCP_SERVICE_TOKEN=
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8765
# 相对路径统一以项目根目录解析，与API/MCP启动目录无关；集成记录不写入app.db
INTEGRATION_DB_PATH=backend/data/integration.db
KNOWLEDGE_DIR=knowledge
